# ── Aplikasi ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Catat Duit
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info

# Origin yang boleh mengakses API (pisahkan dengan koma).
# Aplikasi mobile native tidak mengirim Origin, jadi daftar ini untuk web/Expo web.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
TRUST_PROXY=false

# ── Database PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql://catatduit:catatduit@localhost:5435/catatduit
TEST_DATABASE_URL=postgresql://catatduit:catatduit@localhost:5435/catatduit_test
DB_SSL=false
DB_POOL_MAX=10

# ── Better Auth ────────────────────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:4000
# Wajib minimal 32 karakter. Buat dengan: openssl rand -hex 32
BETTER_AUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
BETTER_AUTH_RATE_LIMIT_ENABLED=true

# ── Rate limit Express ─────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Email transaksional ────────────────────────────────────────────────────
# log    = tulis email + tautan ke log (hanya untuk development/test)
# resend = kirim lewat Resend (wajib RESEND_API_KEY)
EMAIL_TRANSPORT=log
ALLOW_INSECURE_EMAIL_LOG=false
# RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Catat Duit <no-reply@catatduit.app>

# Deep link aplikasi mobile untuk reset password.
APP_RESET_PASSWORD_URL=catatduit://auth/reset-password
APP_EMAIL_VERIFICATION_CALLBACK_URL=catatduit://auth/email-verified

# ── Dokumentasi ────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
