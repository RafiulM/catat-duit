# Base URL of the Catat Duit backend.
# Samakan dengan PORT di backend/.env (default backend: 4000).
#
# iOS simulator / web di komputer yang sama: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Perangkat fisik (Expo Go): saat development, host localhost otomatis diganti
#   IP LAN komputer yang menjalankan Metro. Isi IP manual hanya bila perlu,
#   mis. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
